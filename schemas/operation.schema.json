{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidoc.dev/schema/0.2/operation.schema.json",
  "title": "AIDoc operation",
  "type": "object",
  "required": ["id", "type", "expected_revision", "actor"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "enum": ["create", "update", "delete", "move", "rename", "replace", "link", "unlink", "split", "merge", "revert", "branch"]
    },
    "target": { "type": ["string", "null"] },
    "targets": { "type": "array", "items": { "type": "string" } },
    "expected_revision": { "type": "string", "minLength": 1 },
    "expected_hash": { "type": ["string", "null"] },
    "target_revision": { "type": ["string", "null"] },
    "actor": { "type": "object", "additionalProperties": true },
    "patch": {
      "type": ["object", "null"],
      "properties": {
        "content": { "type": "string" },
        "title": { "type": "string" },
        "kind": { "type": "string" },
        "semantic_type": { "type": "string" },
        "position": { "type": "integer", "minimum": 0 },
        "attributes": {
          "type": "object",
          "description": "String metadata. For link operations, relation_kind selects the relation type.",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "reason": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
