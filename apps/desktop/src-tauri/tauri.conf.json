{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIDoc Desktop",
  "version": "0.1.0",
  "identifier": "dev.aidoc.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AIDoc Desktop",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AIDoc desktop shell",
    "copyright": "© 2026 AIDoc",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/aidoc/desktop-releases/releases/latest/download/{{target}}/{{arch}}/{{version}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_WITH_PUBLIC_KEY_FROM_TAURI_GENERATE_APP",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
